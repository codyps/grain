/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' blob: data:; media-src 'self' blob:; script-src 'self'; style-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/tier2.js
  Cache-Control: no-cache

/styles.css
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: public, max-age=3600

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/deploy/*
  X-Robots-Tag: noindex

/README.md
  X-Robots-Tag: noindex

/make_icons.py
  X-Robots-Tag: noindex

/netlify.toml
  X-Robots-Tag: noindex
